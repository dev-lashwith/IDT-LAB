# Firebase web app values (public by design; Firebase Auth/Firestore rules still matter)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
APP_BASE_URL=

# Server-only Admin SDK. On a VPS, put the service account JSON in this variable
# or use Application Default Credentials. Never commit a service account key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated trusted admin email addresses (optional; otherwise set users/{uid}.role=admin)
ADMIN_EMAILS=

# Demo access is enabled automatically for local development without Admin credentials.
# Set DEMO_MODE=false for production; production requires Firebase Admin credentials.
DEMO_MODE=true
DEMO_SESSION_SECRET=change-this-to-a-long-random-value
